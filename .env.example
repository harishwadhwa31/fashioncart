# FashionCart environment variables.
#
# The two servers read these from the process environment. For local runs, set them in your
# shell; on Vercel, add them under each project's Settings > Environment Variables. Nothing loads
# this file automatically. The Python scripts in scripts/ read API keys from a .env file at the
# repository root, if you create one by copying this file.
#
# Never commit a real .env.

# ---------------------------------------------------------------------------
# MCP server (packages/mcp-server)
# ---------------------------------------------------------------------------

# Port for local runs. Default 3001.
PORT=3001

# Shared HMAC secret that signs checkout links. MUST match the merchant site's value.
# Required in production; local development falls back to an insecure built-in value.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHECKOUT_SECRET=replace-with-a-long-random-hex-string

# Where checkout links send the shopper. Default http://localhost:3002.
MERCHANT_URL=https://your-merchant-project.vercel.app

# This server's own public origin. Optional: on Vercel it is derived from the project's
# production URL, and locally it defaults to http://localhost:3001.
# PUBLIC_URL=https://your-mcp-project.vercel.app

# Optional tuning.
# CHECKOUT_TTL_SECONDS=900
# DEFAULT_PAGE_SIZE=24
# MAX_PAGE_SIZE=40

# Optional overrides for where the catalog and the built widget are read from.
# DATA_DIR=
# WIDGET_DIST_DIR=

# Experimental and untested against any real host. Leave off.
# ENABLE_CHATGPT_MIME=false

# ---------------------------------------------------------------------------
# Merchant site (packages/merchant)
# ---------------------------------------------------------------------------

# Port for local runs. Default 3002. (Set per process; both servers read PORT.)
# PORT=3002

# Same value as the MCP server's CHECKOUT_SECRET.
# CHECKOUT_SECRET=replace-with-the-same-value-as-above

# Product images are served by the MCP server deployment. Default http://localhost:3001.
IMAGE_BASE_URL=https://your-mcp-project.vercel.app

# The connector URL shown on the site's /connect page. Default http://localhost:3001/mcp.
FC_MCP_URL=https://your-mcp-project.vercel.app/mcp

# ---------------------------------------------------------------------------
# Optional developer scripts (scripts/*.py)
# ---------------------------------------------------------------------------

# Only for scripts/build_images.py --source pexels (fetching stock photos).
PEXELS_API_KEY=

# Only for scripts/count_tokens.py and scripts/eval_tool_selection.py.
ANTHROPIC_API_KEY=
